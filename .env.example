# Ambiente novo? Antes de criar um projeto Supabase, leia
# docs/INFRA-PRODUCAO.md: a região sa-east-1 (São Paulo) é REQUISITO, não o
# default do fornecedor, e a Política de Privacidade afirma a titulares que o
# dado não sai do Brasil.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key-from-supabase-status

# Usadas só por scripts/bootstrap_admin.sh (cria o primeiro Administrador do
# distrito). SUPABASE_SERVICE_ROLE_KEY vem do "supabase status" local; em
# produção é o service_role key real — nunca comitar preenchido.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-from-supabase-status
# scripts/bootstrap_admin.sh faz "source" deste arquivo em bash — valores
# com espaço precisam de aspas.
ADMIN_EMAIL=admin@example.com
ADMIN_SENHA=replace-with-a-strong-password
ADMIN_NOME="Nome Completo"
ADMIN_GENERO=masculino
ADMIN_IDADE=30
ADMIN_IGREJA=
